# SpaceX Mission Control — copy to .env

# development | production | test
APP_ENV=development

# SQLite for local development. Switch to Postgres in production:
# DATABASE_URL=postgresql+asyncpg://spacex:spacex@postgres:5432/spacex
DATABASE_URL=sqlite+aiosqlite:///./data/mission_control.db

API_HOST=0.0.0.0
API_PORT=8000
# Hosts that set $PORT (Railway, Render, Fly) override this at process start.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Set automatically in the root Dockerfile. Leave empty for API-only local runs.
FRONTEND_DIST=

# Outbound SpaceX CMS
SPACEX_CMS_BASE_URL=https://content.spacex.com
SPACEX_SITE_BASE_URL=https://www.spacex.com
SPACEX_USER_AGENT=SpaceXMissionControl/1.0 (+https://github.com; mission-status dashboard)
SPACEX_HTTP_TIMEOUT_SECONDS=15
SPACEX_HTTP_RETRIES=3

# Ingestion cadence (seconds)
INGEST_INTERVAL_NORMAL_SECONDS=600
INGEST_INTERVAL_WITHIN_6H_SECONDS=120
INGEST_INTERVAL_WITHIN_30M_SECONDS=45
INGEST_INTERVAL_ACTIVE_SECONDS=20
INGEST_FULL_CATALOG_SECONDS=600
INGEST_RECENT_LIMIT=18
INGEST_UPCOMING_DETAIL_LIMIT=12

# Optional: seed the database from fixtures if the first live fetch fails (dev only)
SEED_FROM_FIXTURES_ON_FAILURE=true

# Enable the optional Playwright HTML fallback (off by default; CMS JSON is primary)
SPACEX_PLAYWRIGHT_FALLBACK=false

# API
API_RATE_LIMIT=60/minute
LOG_LEVEL=INFO
